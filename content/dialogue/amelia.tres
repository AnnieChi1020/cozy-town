[sub_resource type="Resource" id="Resource_od2bi"]
script = ExtResource("1_s6nq2")
id = &"intro"
pages = PackedStringArray("哎呀，新面孔！我是 Amelia，在鎮上開花店。", "這個小鎮很安靜，大家都很友善，你一定會喜歡這裡的。")
set_flag = &"met_amelia"

[sub_resource type="Resource" id="Resource_dmn4l"]
script = ExtResource("1_s6nq2")
id = &"again"
pages = PackedStringArray("今天天氣真好，很適合散步呢。")

[sub_resource type="Resource" id="Resource_lqjvm"]
script = ExtResource("1_s6nq2")
id = &"cat_hint"
pages = PackedStringArray("你在幫 Alex 找麻糬？真是個好人！", "我早上好像看到一隻白貓，往東邊的草地跑過去了。")
set_flag = &"amelia_gave_cat_hint"

[sub_resource type="Resource" id="Resource_rnmoq"]
script = ExtResource("1_s6nq2")
id = &"glad"
pages = PackedStringArray("聽說麻糬找到了？太好了！Alex 一定很開心。")

[resource]
