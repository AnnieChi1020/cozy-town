nodes = Array[ExtResource("1_s6nq2")]([SubResource("Resource_go14d"), SubResource("Resource_hihs2"), SubResource("Resource_x6sd1"), SubResource("Resource_od2bi"), SubResource("Resource_dmn4l"), SubResource("Resource_lqjvm"), SubResource("Resource_rnmoq")])
